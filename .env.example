# Optional absolute path to the portfolio website repository.
# This is the only repository the editor can write, commit and push.
# Default: ../RevPortfolioClaritys (sibling checkout of this editor).
# PORTFOLIO_REPO_PATH=/path/to/RevPortfolioClaritys

# Push guard: this must match the production repository's origin remote.
# Defaults to https://github.com/Claritys11/RevPortfolioClaritys.
# EXPECTED_PORTFOLIO_REMOTE=https://github.com/Claritys11/RevPortfolioClaritys

# Fetch the production origin automatically once when the Node.js Editor server boots.
# A clean branch is fast-forwarded only; dirty or diverged branches are never rewritten.
# Set false to disable startup sync. Manual fetch remains available in Repository health.
# EDITOR_AUTO_FETCH=false
